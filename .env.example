# HawaiiHub.net - 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ==================== Firecrawl API ====================
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# ==================== 火鸟门户系统 API ====================
HUONIAO_API_BASE_URL=https://your-huo-niao-instance.com/api
HUONIAO_API_KEY=your_huo_niao_api_key_here
HUONIAO_DEFAULT_CATEGORY_ID=1
HUONIAO_DEFAULT_AUTHOR_ID=1

# ==================== 数据库配置 ====================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
DATABASE_URL=postgresql://user:password@localhost:5432/hawaiihub

# ==================== Redis 配置 ====================
REDIS_URL=redis://localhost:6379/0

# ==================== 任务调度配置 ====================
TASK_STORAGE_PATH=./tasks
MAX_WORKERS=5

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ==================== GitHub 配置 ====================
GITHUB_TOKEN=your_github_token_here

# ==================== Apify 配置 ====================
APIFY_TOKEN=your_apify_token_here

# ==================== 其他配置 ====================
PROJECT_ROOT=/Users/zhiledeng/Movies/Hawaiihub.net
ENVIRONMENT=development
