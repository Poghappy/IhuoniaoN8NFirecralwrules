# Docker Hub MCP Server 配置示例
# 复制此文件为 .env 并填入真实的令牌

# Docker Hub 个人访问令牌
# 获取方式: https://hub.docker.com/settings/security
DOCKER_HUB_PAT=dckr_pat_YOUR_TOKEN_HERE

# Firecrawl API 密钥 (可选)
# 获取方式: https://www.firecrawl.dev/
FIRECRAWL_API_KEY=fc-YOUR_API_KEY_HERE

# GitHub 个人访问令牌 (可选)
# 获取方式: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_YOUR_TOKEN_HERE

# Docker Hub 命名空间 (您的 Docker Hub 用户名)
DOCKER_HUB_NAMESPACE=your_username

# 项目根目录 (用于 filesystem MCP Server)
PROJECT_ROOT=/Users/zhiledeng/Downloads/docker
