export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# 检查文件编码
file -bi filename

# 转换文件编码
iconv -f GBK -t UTF-8 input.txt > output.txt

# 设置行尾符
dos2unix filename  # 转换为Unix格式
unix2dos filename  # 转换为Windows格式
```

#### 文件编码检查脚本

```bash
#!/bin/bash
# 检查项目文件编码

check_encoding() {
    local file="$1"
    local encoding=$(file -bi "$file" | cut -d= -f2)

    if [ "$encoding" != "utf-8" ]; then
        echo "警告：文件 $file 编码不是UTF-8 ($encoding)"
        return 1
    fi
    return 0
}

# 检查所有Python文件
find src/ -name "*.py" -exec bash -c 'check_encoding "$0"' {} \;
```

