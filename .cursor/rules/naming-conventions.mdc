## 📄 文件管理规范

### 1. 文件创建规范

#### 新文件创建流程

```bash
# 1. 检查文件是否已存在
if [ -f "new_file.py" ]; then
    echo "文件已存在，请检查是否需要覆盖"
    exit 1
fi

# 2. 创建文件并添加标准头部
cat > new_file.py << 'EOF'
"""
new_file.py

文件描述和用途说明

Author: 作者姓名
Date: $(date +%Y-%m-%d)
Version: 1.0.0
"""

# 标准库导入
import os
import sys
from typing import Dict, List, Optional

# 第三方库导入
import requests

# 本地模块导入
from src.core.collector import Collector

# 模块级变量
DEFAULT_TIMEOUT = 30

# 类和函数定义
class NewClass:
    """新类描述"""
    pass

def new_function() -> None:
    """新函数描述"""
    pass

# 模块执行代码
if __name__ == "__main__":
    # 模块执行逻辑
    pass
EOF

# 3. 设置文件权限
chmod 644 new_file.py

# 4. 添加到版本控制
git add new_file.py
```

#### 文件命名检查

```bash
# 检查文件名是否符合规范
check_filename() {
    local filename="$1"

    # 检查是否包含空格或特殊字符
    if [[ "$filename" =~ [[:space:]] ]]; then
        echo "错误：文件名不能包含空格"
        return 1
    fi

    # 检查是否包含中文字符
    if [[ "$filename" =~ [^\x00-\x7F] ]]; then
        echo "警告：文件名包含非ASCII字符"
    fi

    # 检查是否以点开头
    if [[ "$filename" =~ ^\. ]]; then
        echo "警告：文件名以点开头，可能是隐藏文件"
    fi

    return 0
}
```

